<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400" role="img" aria-labelledby="logoTitle logoDesc">
  <title id="logoTitle">VangVieng Stay Logo</title>
  <desc id="logoDesc">Circular nature emblem featuring Vang Vieng karst mountains, Nam Song river, hot air balloon, paramotor, and VangVieng Stay text.</desc>

  <defs>
    
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFE8B8" />
      <stop offset="55%" stop-color="#FFF6E5" />
      <stop offset="100%" stop-color="#DDF3EE" />
    </linearGradient>

    
    <linearGradient id="mtnBack" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4A8B7C" />
      <stop offset="100%" stop-color="#2D6257" />
    </linearGradient>

    <linearGradient id="mtnFront" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2D6A4F" />
      <stop offset="100%" stop-color="#1B4332" />
    </linearGradient>

    
    <linearGradient id="riverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#48CAE4" />
      <stop offset="50%" stop-color="#0096C7" />
      <stop offset="100%" stop-color="#023E8A" />
    </linearGradient>

    
    <clipPath id="innerCircleClip">
      <circle cx="200" cy="200" r="144" />
    </clipPath>

    
    <path id="bottomTextArc" d="M 52,205 A 148,148 0 0,0 348,205" fill="none" />
  </defs>

  
  <circle cx="200" cy="200" r="190" fill="#FFFFFF" stroke="#483D8B" stroke-width="6" />
  <circle cx="200" cy="200" r="181" fill="#F8F9FC" stroke="#F4A261" stroke-width="2.5" />

  
  <g clip-path="url(#innerCircleClip)">
    
    <rect x="50" y="50" width="300" height="300" fill="url(#skyGrad)" />

    
    <circle cx="200" cy="145" r="42" fill="#F9C74F" opacity="0.85" />

    
    <path d="M88,118 Q98,108 110,115 Q122,106 134,116 Q142,118 140,126 L86,126 Q82,122 88,118 Z" fill="#FFFFFF" opacity="0.85" />
    <path d="M256,96 Q265,88 275,94 Q285,87 294,95 Q300,98 298,104 L254,104 Q251,100 256,96 Z" fill="#FFFFFF" opacity="0.8" />

    
    <g transform="translate(112, 118)">
      
      <path d="M0,-28 C-16,-28 -22,-13 -16,2 C-12,11 -6,17 -5,20 L5,20 C6,17 12,11 16,2 C22,-13 16,-28 0,-28 Z" fill="#E76F51" />
      
      <path d="M0,-28 C-7,-28 -9,-13 -7,2 C-5,11 -3,17 -2.5,20 L2.5,20 C3,17 5,11 7,2 C9,-13 7,-28 0,-28 Z" fill="#F4A261" />
      
      <path d="M0,-28 C-2.5,-28 -3,-13 -2.5,2 L2.5,2 C3,-13 2.5,-28 0,-28 Z" fill="#FFE8A3" />
      
      <line x1="-4" y1="20" x2="-3" y2="25" stroke="#5C4033" stroke-width="1.2" />
      <line x1="4" y1="20" x2="3" y2="25" stroke="#5C4033" stroke-width="1.2" />
      <rect x="-4.5" y="25" width="9" height="6" rx="1.5" fill="#7F4F24" />
    </g>

    
    <g transform="translate(274, 126) rotate(-8)">
      
      <path d="M-24,4 Q0,-12 24,4 Q12,-2 0,-2 Q-12,-2 -24,4 Z" fill="#2A9D8F" stroke="#1D6F65" stroke-width="1" />
      
      <line x1="-18" y1="3" x2="-2" y2="19" stroke="#4A5568" stroke-width="0.8" />
      <line x1="18" y1="3" x2="2" y2="19" stroke="#4A5568" stroke-width="0.8" />
      <line x1="-7" y1="0" x2="-1" y2="19" stroke="#4A5568" stroke-width="0.8" />
      <line x1="7" y1="0" x2="1" y2="19" stroke="#4A5568" stroke-width="0.8" />
      
      <circle cx="0" cy="21" r="2.2" fill="#2B2D42" />
      <rect x="-2.5" y="23" width="5" height="5" rx="1.5" fill="#E76F51" />
      <circle cx="3.2" cy="25.5" r="3" fill="none" stroke="#2B2D42" stroke-width="1" />
    </g>

    
    <path d="M50,245 L88,182 L106,204 L132,164 L162,210 L194,154 L226,206 L256,168 L286,208 L314,178 L350,245 Z" fill="url(#mtnBack)" />

    
    <path d="M50,260 L78,202 L102,226 L124,185 L154,234 L176,196 L204,242 L238,188 L268,232 L296,198 L350,260 Z" fill="url(#mtnFront)" />

    
    <path d="M50,242 Q130,232 200,242 Q275,252 350,238 L350,350 L50,350 Z" fill="#52B788" />
    <path d="M50,256 Q140,248 220,260 Q290,270 350,255 L350,350 L50,350 Z" fill="#40916C" />

    
    <path d="M168,240 C150,252 215,260 192,276 C168,292 105,302 128,325 C144,340 195,346 235,350 L292,350 C248,342 192,334 182,320 C172,306 232,294 242,276 C250,260 194,250 184,240 Z" fill="url(#riverGrad)" />

    
    <path d="M174,278 Q186,275 198,278" fill="none" stroke="#CAF0F8" stroke-width="2" stroke-linecap="round" opacity="0.8" />
    <path d="M152,312 Q168,308 184,312" fill="none" stroke="#CAF0F8" stroke-width="2.2" stroke-linecap="round" opacity="0.8" />
  </g>

  
  <circle cx="200" cy="200" r="144" fill="none" stroke="#483D8B" stroke-width="4" />

  
  <circle cx="52" cy="186" r="3.5" fill="#F4A261" />
  <circle cx="348" cy="186" r="3.5" fill="#F4A261" />

  
  <text font-family="&#39;Segoe UI&#39;, Roboto, &#39;Helvetica Neue&#39;, Arial, sans-serif" font-size="25" font-weight="800" fill="#483D8B" letter-spacing="2.2">
    <textPath href="#bottomTextArc" startOffset="50%" text-anchor="middle">
      VANGVIENG STAY
    </textPath>
  </text>
</svg>